# Large 3D source assets are kept in Git LFS (not ordinary Git blobs).
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend.zip filter=lfs diff=lfs merge=lfs -text
Assets/DeadSector/World/Vegetation/**/*.png filter=lfs diff=lfs merge=lfs -text
Assets/DeadSector/World/Vegetation/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/DeadSector/World/Vegetation/**/*.exr filter=lfs diff=lfs merge=lfs -text
